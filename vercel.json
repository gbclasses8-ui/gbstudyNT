{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nt.studybeepro.site/api/:path*"
    },
    {
      "source": "/batches.json",
      "destination": "https://nt.studybeepro.site/batches.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
